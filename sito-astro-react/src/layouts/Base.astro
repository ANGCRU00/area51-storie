---
/* Struttura comune a tutte le pagine: testa, simboli SVG e sfondo, testata, piede, script del sito.
   Nel sito vero ogni pagina userebbe questo layout: testata e piede si scrivono UNA volta sola. */
import Sfondo from '../components/statici/Sfondo.astro';
import Testata from '../components/statici/Testata.astro';
import Piede from '../components/statici/Piede.astro';
import Modali from '../components/statici/Modali.astro';
import Script from '../components/statici/Script.astro';
import ScriptFinali from '../components/statici/ScriptFinali.astro';
const { titolo, descrizione } = Astro.props;
---
<!DOCTYPE html>
<html class="scroll-smooth" lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>{titolo}</title>
<meta name="description" content={descrizione}>
<link rel="stylesheet" href="css/style.css">
<link rel="preload" href="fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline src="js/area51.js"></script>
<style is:inline>
  /* Demo: il pulsante "Mostra le isole" evidenzia i pezzi interattivi (le isole React) */
  .vedi-isole .isola { outline: 3px dashed #B9E62E; outline-offset: 6px; border-radius: 14px; position: relative; }
  .vedi-isole .isola::before { content: attr(data-nome); position: absolute; top: -26px; left: 0; z-index: 60; background: #B9E62E; color: #000;
    font: 800 11px/1 system-ui, sans-serif; padding: 5px 8px; border-radius: 6px; white-space: nowrap; letter-spacing: .02em; }
  #demo-isole { position: fixed; right: 16px; bottom: 16px; z-index: 95; background: #5B21B6; color: #fff; border: 2px solid #B9E62E;
    font: 800 13px/1 system-ui, sans-serif; padding: 12px 16px; border-radius: 999px; box-shadow: 4px 4px 0 #B9E62E; cursor: pointer; }
</style>
</head>
<body class="text-brand-text font-body overflow-x-hidden antialiased relative selection:bg-brand-lime selection:text-black">
<Sfondo />
<Testata />
<main id="main" class="relative z-10">
<slot />
</main>
<Piede />
<Script />
<Modali />
<ScriptFinali />
<button id="demo-isole" type="button" aria-pressed="false">Mostra le isole (React)</button>
<script is:inline>
  document.getElementById('demo-isole').addEventListener('click', function () {
    var on = document.body.classList.toggle('vedi-isole');
    this.setAttribute('aria-pressed', on ? 'true' : 'false'); this.textContent = on ? 'Nascondi le isole (React)' : 'Mostra le isole (React)';
  });
</script>
</body>
</html>
