---
import Carrello from '../isole/Carrello.tsx';
---
<!-- Testata -->
<header class="sticky top-0 z-50 bg-[#070514]/90 backdrop-blur-md border-b border-brand-violet/40">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    <a class="flex items-center gap-2 sm:gap-3 group shrink-0" href="index.html" aria-label="Area 51 Fumetteria, home">
      <svg class="w-11 h-11 group-hover:rotate-12 transition-transform" aria-hidden="true"><use href="#alieno"/></svg>
      <span class="flex flex-col leading-none">
        <span class="font-heavy text-xl sm:text-2xl text-white">AREA 51</span>
        <span class="text-[10px] tracking-[0.3em] text-brand-lime font-bold">FUMETTERIA</span>
      </span>
    </a>

    <nav class="hidden min-[1420px]:flex items-center gap-2 relative text-sm font-semibold" id="main-nav" aria-label="Categorie">
      <div class="pointer-events-none absolute -top-4 left-0 z-30" id="nav-ufo-follower" aria-hidden="true">
        <div class="ufo-bobbing flex flex-col items-center drop-shadow-[0_2px_10px_rgba(185,230,46,.65)]">
          <svg class="w-10 h-5" id="nav-ufo-ship"><use href="#disco"/></svg>
          <div class="nav-tractor-light w-8 h-4 -mt-0.5"></div>
        </div>
      </div>
      <div class="flex items-center bg-[#0d0724] border border-brand-violet/60 rounded-full p-1 gap-0.5">
        <a class="nav-link whitespace-nowrap px-2.5 py-2 rounded-full hover:text-brand-lime hover:bg-[#180e3e] transition-colors" href="catalogo.html">Manga &amp; Fumetti</a>
        <a class="nav-link whitespace-nowrap px-2.5 py-2 rounded-full hover:text-brand-lime hover:bg-[#180e3e] transition-colors" href="tcg.html">TCG</a>
        <a class="nav-link whitespace-nowrap px-2.5 py-2 rounded-full hover:text-brand-lime hover:bg-[#180e3e] transition-colors" href="giochi.html">Giochi da tavolo</a>
        <a class="nav-link whitespace-nowrap px-2.5 py-2 rounded-full hover:text-brand-lime hover:bg-[#180e3e] transition-colors" href="figure.html">Figure &amp; Funko</a>
        <a class="nav-link whitespace-nowrap px-2.5 py-2 rounded-full hover:text-brand-lime hover:bg-[#180e3e] transition-colors" href="warhammer.html">Warhammer</a>
        <a class="nav-link whitespace-nowrap px-2.5 py-2 rounded-full hover:text-brand-lime hover:bg-[#180e3e] transition-colors" href="gadget.html">Gadget</a>
        <a class="nav-link whitespace-nowrap px-2.5 py-2 rounded-full hover:text-brand-lime hover:bg-[#180e3e] transition-colors" href="eventi.html">Eventi</a>
      </div>
      <a class="nav-link ml-1 border border-brand-lime/60 hover:bg-brand-lime text-brand-lime hover:text-black font-bold text-xs uppercase tracking-wider whitespace-nowrap px-3 py-2.5 rounded-full transition-colors" href="negozio.html">Il negozio ↗</a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <button type="button" aria-label="Cerca prodotti" class="max-[359px]:hidden w-11 h-11 rounded-full border border-white/15 hover:border-brand-lime flex items-center justify-center hover:text-brand-lime transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-width="2"/></svg>
      </button>
      <a href="profilo.html#preferiti" aria-label="Preferiti" class="relative hidden sm:flex w-11 h-11 rounded-full border border-white/15 hover:border-brand-lime items-center justify-center hover:text-brand-lime transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.3 6.3a4.5 4.5 0 000 6.4L12 20.4l7.7-7.7a4.5 4.5 0 00-6.4-6.4L12 7.6l-1.3-1.3a4.5 4.5 0 00-6.4 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
        <span class="js-pref-n absolute -top-1 -right-1 min-w-[1.1rem] h-[1.1rem] px-1 rounded-full bg-brand-lime text-black font-heavy text-[10px] leading-[1.1rem] text-center" hidden>0</span>
      </a>
      <a href="profilo.html" aria-label="Il tuo profilo" class="hidden sm:flex w-11 h-11 rounded-full border border-white/15 hover:border-brand-lime items-center justify-center hover:text-brand-lime transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 11a4 4 0 100-8 4 4 0 000 8zM4 21v-1a6 6 0 016-6h4a6 6 0 016 6v1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
      </a>
      <div class="isola" data-nome="Isola: Carrello"><Carrello client:load /></div>
      <button type="button" id="menu-btn" aria-label="Apri il menu" aria-expanded="false" aria-controls="menu-mobile" class="min-[1420px]:hidden w-11 h-11 rounded-full border border-white/15 flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" stroke-width="2.2"/></svg>
      </button>
    </div>
  </div>
  <!-- Menu da telefono -->
  <nav id="menu-mobile" hidden aria-label="Menu" class="min-[1420px]:hidden border-t border-brand-violet/40 bg-[#0d0724]">
    <div class="max-w-[1440px] mx-auto px-4 py-4 grid grid-cols-2 gap-2 text-base font-semibold">
      <button type="button" id="cerca-mobile" class="col-span-2 min-[360px]:hidden px-4 py-3 rounded-xl border border-white/15 text-left flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" stroke-linecap="round" stroke-width="2"/></svg>Cerca
      </button>
      <a class="px-4 py-3 rounded-xl bg-white/5" href="catalogo.html">Manga &amp; Fumetti</a>
      <a class="px-4 py-3 rounded-xl bg-white/5" href="tcg.html">TCG</a>
      <a class="px-4 py-3 rounded-xl bg-white/5" href="giochi.html">Giochi da tavolo</a>
      <a class="px-4 py-3 rounded-xl bg-white/5" href="figure.html">Figure &amp; Funko</a>
      <a class="px-4 py-3 rounded-xl bg-white/5" href="warhammer.html">Warhammer</a>
      <a class="px-4 py-3 rounded-xl bg-white/5" href="gadget.html">Gadget</a>
      <a class="px-4 py-3 rounded-xl bg-white/5" href="eventi.html">Eventi</a>
      <a class="px-4 py-3 rounded-xl border border-brand-lime text-brand-lime text-center" href="negozio.html">Il negozio ↗</a>
      <a href="profilo.html" class="col-span-2 px-4 py-3 rounded-xl bg-white/5">Il tuo profilo</a>
    </div>
  </nav>
  <!-- Ricerca: si apre dalla lente; suggerisce le serie mentre si scrive, invio apre il catalogo -->
  <div id="ricerca" hidden class="absolute inset-x-0 top-full border-b border-brand-violet/40 bg-[#0d0724] shadow-[0_18px_30px_rgba(0,0,0,.45)]">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <form id="ricerca-form" role="search" action="catalogo.html" method="get" class="flex items-center gap-2 sm:gap-3">
        <label for="ricerca-input" class="sr-only">Cerca un titolo o un autore</label>
        <input id="ricerca-input" name="cerca" type="search" autocomplete="off" maxlength="60" placeholder="Cerca un titolo o un autore" class="flex-1 min-w-0 bg-[#120a2e] border border-brand-violet/60 focus:border-brand-lime focus:ring-1 focus:ring-brand-lime text-white placeholder-brand-muted/70 rounded-full px-5 py-3 text-base">
        <button type="submit" class="shrink-0 bg-brand-lime text-black font-heavy text-sm px-5 sm:px-6 py-3 rounded-full shadow-brutal-violet hover:bg-[#a6d420] transition-colors">Cerca</button>
        <button type="button" id="ricerca-chiudi" aria-label="Chiudi la ricerca" class="shrink-0 w-11 h-11 rounded-full border border-white/15 hover:border-brand-lime hover:text-brand-lime flex items-center justify-center transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" stroke-width="2.4"/></svg>
        </button>
      </form>
      <ul id="ricerca-risultati" hidden class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3"></ul>
      <p id="ricerca-nota" role="status" class="mt-3 text-xs font-semibold text-brand-muted"></p>
    </div>
  </div>
</header>

