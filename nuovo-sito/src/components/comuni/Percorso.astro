---
/* Percorso in cima alle pagine interne: Home / … / pagina attuale */
interface Props { voci: { testo: string; href?: string }[] }
const { voci } = Astro.props;
---
<nav aria-label="Percorso" class="percorso">
  <a href="/">Home</a>
  {voci.map((v) => (
    <>
      <span aria-hidden="true" class="barra">/</span>
      {v.href ? <a href={v.href}>{v.testo}</a> : <span class="attuale" aria-current="page">{v.testo}</span>}
    </>
  ))}
</nav>

<style>
  .percorso { font-size: .75rem; font-weight: 600; color: var(--testo-tenue); margin-bottom: 1.25rem; }
  .percorso a:hover { color: var(--lime); }
  .barra { margin-inline: .375rem; color: var(--viola-acceso); }
  .attuale { color: #fff; }
  @media (max-width: 767px) { .percorso a { display: inline-block; padding-block: .45rem; } }
</style>
