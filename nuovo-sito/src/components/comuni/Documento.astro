---
/* Impaginazione delle pagine di solo testo (privacy, condizioni): percorso, bollino, titolo, introduzione,
   avviso arancione facoltativo e il testo a colonna stretta. Le sezioni del testo usano h2, p, ul.punti, span.evid, p.nota. */
interface Props { bollino: string }
const { bollino } = Astro.props;
---
<div class="contenitore documento">
  <slot name="percorso" />
  <header class="testa">
    <span class="bollino">{bollino}</span>
    <h1 class="pesante"><slot name="titolo" /></h1>
    <p class="introduzione"><slot name="introduzione" /></p>
  </header>
  {Astro.slots.has('avviso') && <p class="avviso"><slot name="avviso" /></p>}
  <div class="testo">
    <slot />
  </div>
</div>

<style>
  .documento { padding-block: 2rem 4rem; }
  @media (min-width: 1024px) { .documento { padding-top: 3.5rem; } }
  .testa { margin-bottom: 2rem; }
  .testa .bollino { margin-bottom: .75rem; }
  h1 { font-size: 1.875rem; line-height: 1.25; color: #fff; text-wrap: balance; }
  @media (min-width: 640px) { h1 { font-size: 3rem; } }
  .introduzione { margin-top: .75rem; max-width: 48rem; font-size: .875rem; font-weight: 600; color: var(--testo-tenue); line-height: 1.625; }
  @media (min-width: 640px) { .introduzione { font-size: 1rem; } }
  .avviso { margin-bottom: 2rem; max-width: 48rem; border-radius: .75rem; border: 2px solid #FB923C; background: rgb(251 146 60 / .1); padding: .75rem 1rem;
    font-size: .875rem; font-weight: 600; color: #fff; line-height: 1.625; }
  .avviso :global(b) { font-weight: 900; font-stretch: 125%; color: #FB923C; }

  .testo { max-width: 48rem; display: grid; gap: 2rem; font-size: .875rem; font-weight: 600; color: var(--testo-tenue); line-height: 1.625; }
  @media (min-width: 640px) { .testo { font-size: 1rem; } }
  .testo :global(h2) { font-size: 1.25rem; color: #fff; margin-bottom: .5rem; }
  .testo :global(p + p), .testo :global(ul + p) { margin-top: .75rem; }
  .testo :global(.punti) { list-style: disc; padding-left: 1.25rem; display: grid; gap: .75rem; }
  .testo :global(.evid) { color: #fff; }
  .testo :global(a) { color: var(--lime); text-decoration: underline; }
  .testo :global(a:hover) { color: #fff; }
  .testo :global(.nota) { font-size: .75rem; }
</style>
