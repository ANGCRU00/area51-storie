---
/* Riquadro fisso della home (prossimo evento, ultimo arrivo): stesso aspetto dell'isola StatoNegozio. */
import css from '../isole/Riquadro.module.css';
interface Props {
  href: string;
  titolo: string;
  sotto: string;
  icona: 'calendario' | 'libro';
}
const { href, titolo, sotto, icona } = Astro.props;
---

<a href={href} class={css.riquadro}>
  {icona === 'calendario' ? (
    <svg
      class={css.icona}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M8 3v4M16 3v4M3 10h18" />
    </svg>
  ) : (
    <svg
      class={css.icona}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M4 5a2 2 0 012-2h12v18H6a2 2 0 01-2-2V5z" />
      <path d="M8 3v18" />
    </svg>
  )}
  <span class={css.testi}>
    <b class={'pesante ' + css.titolo}>{titolo}</b>
    <span class={css.sotto}>{sotto}</span>
  </span>
</a>
