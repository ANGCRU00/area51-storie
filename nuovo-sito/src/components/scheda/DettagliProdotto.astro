---
import { dettagliDi, type Prodotto } from '../../lib/prodotti';

interface Props {
  prodotto: Prodotto;
}
const voci = dettagliDi(Astro.props.prodotto);
---

<dl class="dettagli">
  {voci.map(({ nome, valore }) => (
    <div>
      <dt>{nome}</dt>
      <dd>{valore}</dd>
    </div>
  ))}
</dl>

<style>
  .dettagli {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
    padding: 1.1rem 1.25rem;
    border: 2px solid rgb(185 230 46 / 0.6);
    border-radius: var(--raggio);
    background: rgb(14 9 38 / 0.95);
  }
  @media (max-width: 639px) {
    .dettagli {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem 1rem;
      padding: 1rem;
    }
  }
  .dettagli div {
    min-width: 0;
  }
  dt {
    font-size: 11px;
    font-weight: 700;
    color: var(--testo-tenue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  dd {
    margin: 0.2rem 0 0;
    color: #fff;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
</style>
