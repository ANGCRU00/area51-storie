---
import type { Prodotto } from '../../lib/prodotti';

interface Props {
  prodotto: Prodotto;
}
const { prodotto: p } = Astro.props;
---

<section class="sotto">
  <div class="riquadro trama">
    <h2 class="pesante">Trama &amp; dettagli</h2>
    <p>
      La trama di questo volume non è ancora disponibile: la scriviamo noi del negozio, un titolo alla volta.
      Vuoi saperne di più? Chiedici in negozio.
    </p>
    {p.autore && (
      <p>
        <span class="evid">Autore:</span> {p.autore}
      </p>
    )}
    {p.pagine && (
      <p>
        <span class="evid">Pagine:</span> {p.pagine}
      </p>
    )}
  </div>
  <aside class="riquadro ritiro">
    <h2 class="pesante">Ritiro in negozio</h2>
    <ul>
      <li>
        <b class="pesante">Ritiri tu</b>
        <span>Viale G. Falcone e P. Borsellino, 35, Barletta</span>
      </li>
      <li>
        <b class="pesante">Paghi al ritiro</b>
        <span>Anche con Carta della Cultura e Carta del Merito</span>
      </li>
      <li>
        <b class="pesante">Nessuna spedizione</b>
        <span>Negli orari di apertura del negozio</span>
      </li>
    </ul>
    <a class="collegamento" href="/negozio">
      Orari e mappa →
    </a>
  </aside>
</section>

<style>
  .sotto {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .sotto {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
    .ritiro {
      position: sticky;
      top: calc(var(--altezza-testata) + 1rem);
    }
  }
  h2 {
    font-size: 1.25rem;
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .trama {
    display: grid;
    gap: 0.6rem;
    color: var(--testo-tenue);
    font-weight: 600;
    line-height: 1.6;
  }
  .evid {
    color: #fff;
  }
  .ritiro ul {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .ritiro li {
    display: grid;
    gap: 0.15rem;
    font-size: 0.85rem;
    color: var(--testo-tenue);
    font-weight: 600;
  }
  .ritiro b {
    color: #fff;
    font-size: 0.95rem;
  }
  .collegamento {
    color: var(--lime);
    font-weight: 700;
    font-size: 0.875rem;
  }
  .collegamento:hover {
    text-decoration: underline;
  }
</style>
