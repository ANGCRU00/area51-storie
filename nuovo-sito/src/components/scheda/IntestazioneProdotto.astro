---
import { eLibro, NOME_CATEGORIA, siPrenota, TESTO_DISPONIBILITA, type Prodotto } from '../../lib/prodotti';

interface Props {
  prodotto: Prodotto;
}
const { prodotto: p } = Astro.props;

const nonDisponibile = p.disponibilita === 'esaurito' || p.disponibilita === 'uscito';
const edizioneSpeciale = p.edizione && p.edizione !== 'Standard';
const titoloInteroDaMostrare = p.serie !== p.titolo && !p.volume;
---

<div class="etichette">
  <span class:list={['pesante etichetta', { viola: siPrenota(p), grigia: nonDisponibile }]}>
    {TESTO_DISPONIBILITA[p.disponibilita]}
  </span>
  {p.categoria && <span class="etichetta tenue">{NOME_CATEGORIA[p.categoria]}</span>}
  {edizioneSpeciale && <span class="etichetta tenue">{p.edizione}</span>}
  {p.perAdulti && <span class="pesante etichetta arancio">18+ · per adulti</span>}
</div>

<h1 class="pesante">{p.serie}</h1>
{p.volume && <p class="pesante volume">Volume {p.volume}</p>}
{titoloInteroDaMostrare && <p class="titolo-intero">{p.titolo}</p>}

{eLibro(p) && (
  <button
    type="button"
    class="segui"
    id="segui"
    aria-pressed="false"
    data-serie={p.serie}
    data-editore={p.editore ?? ''}
    data-codice-serie={p.codiceSerie ?? ''}
  >
    Segui la serie
  </button>
)}

<script>
  import { ascolta, serie } from '../../lib/negozio';

  const pulsante = document.getElementById('segui') as HTMLButtonElement | null;
  const nome = pulsante?.dataset.serie ?? '';
  const editore = pulsante?.dataset.editore ?? '';
  const codiceSerie = pulsante?.dataset.codiceSerie ?? '';

  function mostraStato() {
    if (!pulsante) return;
    const seguita = serie.ha(nome, editore);
    pulsante.setAttribute('aria-pressed', String(seguita));
    pulsante.textContent = seguita ? 'Segui già questa serie ✓' : 'Segui la serie';
  }

  pulsante?.addEventListener('click', () => serie.scambia(nome, editore, codiceSerie));
  ascolta(mostraStato);
  mostraStato();
</script>

<style>
  .etichette {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .etichetta {
    font-size: 0.75rem;
    padding: 0.3rem 0.75rem;
    border-radius: 0.375rem;
    background: var(--lime);
    color: #000;
  }
  .etichetta.viola {
    background: var(--viola);
    color: #fff;
  }
  .etichetta.grigia {
    background: #3a2f5e;
    color: #fff;
  }
  .etichetta.arancio {
    background: #fb923c;
    color: #000;
  }
  .etichetta.tenue {
    background: none;
    border: 1px solid var(--linea);
    color: var(--testo-tenue);
    font-weight: 700;
  }
  h1 {
    font-size: 2rem;
    line-height: 1.1;
    color: #fff;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  @media (min-width: 640px) {
    h1 {
      font-size: 2.75rem;
    }
  }
  .volume {
    font-size: 1.5rem;
    color: var(--lime);
    margin-top: -0.6rem;
  }
  .titolo-intero {
    color: var(--testo-tenue);
    font-weight: 700;
    margin-top: -0.5rem;
  }
  .segui {
    justify-self: start;
    margin-top: -0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--raggio-pillola);
    border: 1px solid rgb(255 255 255 / 0.2);
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 900;
    font-stretch: 125%;
    transition:
      color var(--transizione),
      border-color var(--transizione),
      background-color var(--transizione);
  }
  .segui:hover {
    border-color: var(--lime);
    color: var(--lime);
  }
  .segui[aria-pressed='true'] {
    background: var(--lime);
    color: #000;
    border-color: var(--lime);
  }
</style>
