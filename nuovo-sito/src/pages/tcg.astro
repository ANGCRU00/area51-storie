---
import Base from '../layouts/Base.astro';
import PaginaCatalogo from '../components/catalogo/PaginaCatalogo.astro';
import { impostaCachePaginaDinamica } from '../lib/cache';

export const prerender = false;
impostaCachePaginaDinamica(Astro.response.headers);
---

<Base
  titolo="TCG · Area 51 Fumetteria Barletta"
  descrizione="Carte collezionabili (TCG) alla Fumetteria Area 51 di Barletta: Magic, Pokémon, One Piece, Riftbound e altro."
>
  <PaginaCatalogo
    categorie={['tcg']}
    percorso="TCG"
    bollino="Carte collezionabili"
    titolo="TCG"
    introduzione="Bustine, box, mazzi e accessori per i giochi di carte collezionabili. Le prossime uscite si prenotano."
  />
</Base>
