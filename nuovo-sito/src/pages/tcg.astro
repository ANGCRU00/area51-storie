---
/* TCG: articoli del magazzino e prossime uscite da D1 (src/lib/prodotti.ts). Pagina scritta a ogni richiesta. */
import Base from '../layouts/Base.astro';
import Elenco from '../components/prodotti/Elenco.astro';
import { COOKIE_ADULTI, cercaProdotti, filtriDaIndirizzo, type Categoria } from '../lib/prodotti';

export const prerender = false;
const disponibili: Categoria[] = ['tcg'];
const filtri = filtriDaIndirizzo(Astro.url, disponibili);
filtri.adulti = Astro.cookies.get(COOKIE_ADULTI)?.value === '1';
const risultato = await cercaProdotti(filtri);
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60');
Astro.response.headers.set('vary', 'cookie');
---
<Base titolo="TCG · Area 51 Fumetteria Barletta" descrizione="Carte collezionabili (TCG) alla Fumetteria Area 51 di Barletta: Magic, Pokémon, One Piece, Riftbound e altro.">
  <Elenco percorso="TCG" bollino="Carte collezionabili" titolo="TCG" introduzione="Bustine, box, mazzi e accessori per i giochi di carte collezionabili. Le prossime uscite si prenotano."
    risultato={risultato} filtri={filtri} categorie={disponibili} />
</Base>
