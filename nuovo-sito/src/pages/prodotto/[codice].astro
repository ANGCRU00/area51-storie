---
/* Scheda prodotto: /prodotto/<EAN o codice Starshop>. Solo dati di fatto: niente descrizioni Starshop né prezzi B2B. */
import Base from '../../layouts/Base.astro';
import Percorso from '../../components/comuni/Percorso.astro';
import AzioniCarrello from '../../components/prodotti/AzioniCarrello.astro';
import AcquistoProdotto from '../../components/scheda/AcquistoProdotto.astro';
import ConfermaEta from '../../components/scheda/ConfermaEta.astro';
import CopertinaProdotto from '../../components/scheda/CopertinaProdotto.astro';
import DettagliProdotto from '../../components/scheda/DettagliProdotto.astro';
import IntestazioneProdotto from '../../components/scheda/IntestazioneProdotto.astro';
import SezioneProdotti from '../../components/scheda/SezioneProdotti.astro';
import TramaERitiro from '../../components/scheda/TramaERitiro.astro';
import { impostaCachePaginaDinamica } from '../../lib/cache';
import {
  COOKIE_ETA_CONFERMATA,
  repartoDi,
  TESTO_DISPONIBILITA,
  trovaProdotto,
  tutteLeEdizioni,
} from '../../lib/prodotti';

export const prerender = false;

const scheda = await trovaProdotto(Astro.params.codice ?? '');
if (!scheda) return Astro.rewrite('/404');
impostaCachePaginaDinamica(Astro.response.headers);

const { prodotto, altri, edizioni, simili } = scheda;
const etaDaConfermare = prodotto.perAdulti && Astro.cookies.get(COOKIE_ETA_CONFERMATA)?.value !== '1';
const reparto = repartoDi(prodotto);
const descrizione =
  prodotto.titolo +
  (prodotto.editore ? ` (${prodotto.editore})` : '') +
  `: ${TESTO_DISPONIBILITA[prodotto.disponibilita].toLowerCase()} alla Fumetteria Area 51 di Barletta.`;
---

<Base titolo={prodotto.titolo + ' · Area 51 Fumetteria'} descrizione={descrizione}>
  <div class="contenitore pagina">
    <Percorso voci={[reparto, { testo: prodotto.titolo }]} />
    {etaDaConfermare && <ConfermaEta />}

    <section class="prodotto">
      <CopertinaProdotto prodotto={prodotto} sfocata={etaDaConfermare} />
      <div class="dati">
        <IntestazioneProdotto prodotto={prodotto} />
        <DettagliProdotto prodotto={prodotto} />
        <AcquistoProdotto prodotto={prodotto} edizioni={tutteLeEdizioni(prodotto, edizioni)} />
      </div>
    </section>

    <TramaERitiro prodotto={prodotto} />
    <SezioneProdotti titolo="Tutti i volumi della serie" prodotti={altri} />
    <SezioneProdotti titolo="Ti potrebbe piacere" prodotti={simili} />
  </div>
  <AzioniCarrello />
</Base>

<style>
  .pagina {
    padding-block: 2rem 4rem;
  }
  .prodotto {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .prodotto {
      grid-template-columns: 300px minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .dati {
    min-width: 0;
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }
</style>
