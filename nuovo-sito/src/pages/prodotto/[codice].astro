---
/* Scheda prodotto: /prodotto/<EAN o codice Starshop>. Cerca prima nel magazzino visibile, poi tra le uscite visibili (D1).
   Struttura concordata (sito attuale, modello Stitch): copertina a sinistra; a destra etichette, serie in grande, "Volume N" in lime,
   scheda con editore, autore, uscita, edizione, pagine, lingua, EAN; prezzo, disponibilità con lo stato del negozio,
   altre edizioni dello stesso volume, quantità e carrello. Sotto: trama e ritiro, tutti i volumi della serie, ti potrebbe piacere.
   Solo dati di fatto: niente descrizioni Starshop né prezzi B2B. Dati mancanti (autore, pagine…) semplicemente non compaiono. */
import Base from '../../layouts/Base.astro';
import Percorso from '../../components/comuni/Percorso.astro';
import Scheda from '../../components/prodotti/Scheda.astro';
import AzioniCarrello from '../../components/prodotti/AzioniCarrello.astro';
import { COOKIE_ADULTI, NOME_CATEGORIA, NOME_GENERE, TESTO_DISPONIBILITA, dataLunga, euro, trovaProdotto } from '../../lib/prodotti';

export const prerender = false;
const trovato = await trovaProdotto(Astro.params.codice ?? '');
if (!trovato) return Astro.rewrite('/404');
const { prodotto: p, altri, edizioni, simili } = trovato;
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60');
Astro.response.headers.set('vary', 'cookie');
// titolo per adulti e visitatore che non ha ancora confermato la maggiore età: copertina sfocata e richiesta di conferma
const chiediEta = p.adulti && Astro.cookies.get(COOKIE_ADULTI)?.value !== '1';

const reparto = p.categoria === 'tcg' ? { testo: 'TCG', href: '/tcg' } : p.categoria === 'giochi' ? { testo: 'Giochi da tavolo', href: '/giochi' }
  : p.categoria === 'figure' ? { testo: 'Figure & Funko', href: '/figure' } : p.categoria === 'gadget' ? { testo: 'Gadget', href: '/gadget' }
  : { testo: 'Manga & Fumetti', href: '/catalogo' };
const prenota = p.disponibilita === 'preordine';
const acquistabile = prenota || p.disponibilita === 'in_negozio' || p.disponibilita === 'appena_arrivato';
const maiuscolaIniziale = (s: string) => s.charAt(0) + s.slice(1).toLowerCase();
const dettagli = [
  ['Editore', p.editore], ['Autore', p.autore], ['Data di uscita', p.dataUscita ? dataLunga(p.dataUscita) : null],
  ['Genere', p.generi.length ? p.generi.map((g) => NOME_GENERE[g] ?? g).join(', ') : null], ['Edizione', p.edizione], ['Pagine', p.pagine ? String(p.pagine) : null], ['Lingua', p.lingua ? maiuscolaIniziale(p.lingua) : null],
  ['Tipo', p.categoria ? NOME_CATEGORIA[p.categoria] : null], ['EAN', p.ean],
].filter((d) => d[1]) as [string, string][];
const tutteLeEdizioni = edizioni.length ? [p, ...edizioni].sort((a, b) => (a.edizione === 'Standard' ? -1 : b.edizione === 'Standard' ? 1 : 0)) : [];
---
<Base titolo={p.titolo + ' · Area 51 Fumetteria'} descrizione={p.titolo + (p.editore ? ' (' + p.editore + ')' : '') + ': ' + TESTO_DISPONIBILITA[p.disponibilita].toLowerCase() + ' alla Fumetteria Area 51 di Barletta.'}>
  <div class="contenitore pagina">
    <Percorso voci={[{ testo: reparto.testo, href: reparto.href }, { testo: p.titolo }]} />

    {chiediEta && (
      <div class="eta" data-cookie={COOKIE_ADULTI}>
        <p class="pesante">Questo titolo è per adulti (18+).</p>
        <p>Per vedere la copertina conferma di avere almeno 18 anni. La scelta resta solo su questo dispositivo.</p>
        <div><button type="button" class="pulsante" data-eta-ok>Ho almeno 18 anni</button> <a class="indietro" href="/catalogo">Torna al catalogo</a></div>
      </div>
    )}
    <section class="prodotto">
      <div class="copertina">
        {p.copertina
          ? <img class:list={[{ sfocata: chiediEta }]} src={p.copertina} alt={'Copertina di ' + p.titolo} width="318" height="484" />
          : <div class="senza"><svg aria-hidden="true"><use href="#alieno" /></svg><span>Copertina non ancora disponibile</span></div>}
      </div>

      <div class="dati">
        <div class="etichette">
          <span class:list={['pesante etichetta', { viola: prenota, grigia: p.disponibilita === 'esaurito' || p.disponibilita === 'uscito' }]}>{TESTO_DISPONIBILITA[p.disponibilita]}</span>
          {p.categoria && <span class="etichetta tenue">{NOME_CATEGORIA[p.categoria]}</span>}
          {p.edizione && p.edizione !== 'Standard' && <span class="etichetta tenue">{p.edizione}</span>}
          {p.adulti && <span class="pesante etichetta arancio">18+ · per adulti</span>}
        </div>
        <h1 class="pesante">{p.serie}</h1>
        {p.volume && <p class="pesante volume">Volume {p.volume}</p>}
        {p.serie !== p.titolo && !p.volume && <p class="titolo-intero">{p.titolo}</p>}

        <dl class="tabella">
          {dettagli.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>

        <div class="acquisto">
          <div class="prezzo-riga">
            <span class="pesante prezzo">{euro(p.prezzo)}</span>
            <span class="disponibile"><span class:list={['spia', { verde: acquistabile && !prenota, viola: prenota }]} aria-hidden="true"></span>{TESTO_DISPONIBILITA[p.disponibilita]}</span>
          </div>
          <p class="negozio" id="stato-negozio" hidden></p>
          {prenota && <p class="nota">{p.dataLimite ? 'Prenota entro il ' + dataLunga(p.dataLimite) + '.' : 'Ultimo giorno per prenotare: da confermare.'} La prenotazione vale quando la confermiamo per email o telefono.</p>}
          {p.disponibilita === 'uscito' && <p class="nota">È già uscito: chiedi in negozio se è disponibile, o scrivici con il modulo Chiedicelo.</p>}
          {p.disponibilita === 'esaurito' && <p class="nota">Al momento è esaurito in negozio: possiamo provare a ordinarlo per te.</p>}

          {tutteLeEdizioni.length > 1 && (
            <div class="edizioni">
              <p class="pesante etichetta-campo">Edizione</p>
              <div class="scelte">
                {tutteLeEdizioni.map((e) => e.codice === p.codice
                  ? <span class="scelta attiva" aria-current="true"><b>{e.edizione ?? 'Standard'}</b><span>{euro(e.prezzo)}</span></span>
                  : <a class="scelta" href={'/prodotto/' + encodeURIComponent(e.codice)}><b>{e.edizione ?? 'Standard'}</b><span>{euro(e.prezzo)}</span></a>)}
              </div>
            </div>
          )}

          <div class="bottoni">
            {acquistabile && (
              <>
                <label class="quantita"><span class="solo-lettori">Quantità</span>
                  <select id="quantita">{[1, 2, 3, 4, 5].map((n) => <option value={n}>{n}</option>)}</select>
                </label>
                <button type="button" class:list={['pulsante', { 'pulsante-viola': prenota }]} data-aggiungi={p.codice} data-titolo={p.titolo} data-prezzo={p.prezzo ?? 0}
                  data-editore={p.editore ?? ''} data-copertina={p.copertina ?? ''} data-preordine={prenota ? '1' : ''} data-quantita-da="quantita">{prenota ? 'Prenota' : 'Aggiungi al carrello'}</button>
              </>
            )}
            {!acquistabile && <a class="pulsante" href="/negozio#chiedicelo">Chiedilo al negozio</a>}
          </div>
        </div>
      </div>
    </section>

    <section class="sotto">
      <div class="riquadro trama">
        <h2 class="pesante">Trama &amp; dettagli</h2>
        <p class="tenue">La trama di questo volume non è ancora disponibile: la scriviamo noi del negozio, un titolo alla volta. Vuoi saperne di più? Chiedici in negozio.</p>
        {p.autore && <p><span class="evid">Autore:</span> {p.autore}</p>}
        {p.pagine && <p><span class="evid">Pagine:</span> {p.pagine}</p>}
      </div>
      <aside class="riquadro ritiro">
        <h2 class="pesante">Ritiro in negozio</h2>
        <ul>
          <li><b class="pesante">Ritiri tu</b><span>Viale G. Falcone e P. Borsellino, 35, Barletta</span></li>
          <li><b class="pesante">Paghi al ritiro</b><span>Anche con Carta della Cultura e Carta del Merito</span></li>
          <li><b class="pesante">Nessuna spedizione</b><span>Negli orari di apertura del negozio</span></li>
        </ul>
        <a class="collegamento" href="/negozio">Orari e mappa →</a>
      </aside>
    </section>

    {altri.length > 0 && (
      <section class="elenco">
        <h2 class="pesante titolo-sezione piccolo">Tutti i volumi della serie</h2>
        <div class="griglia">{altri.map((a) => <Scheda p={a} />)}</div>
      </section>
    )}
    {simili.length > 0 && (
      <section class="elenco">
        <h2 class="pesante titolo-sezione piccolo">Ti potrebbe piacere</h2>
        <div class="griglia">{simili.map((a) => <Scheda p={a} />)}</div>
      </section>
    )}
  </div>
  <AzioniCarrello />
</Base>

<script>
  /* conferma della maggiore età per i titoli 18+ (cookie di 180 giorni) */
  const eta = document.querySelector<HTMLElement>('.eta[data-cookie]');
  eta?.querySelector('[data-eta-ok]')?.addEventListener('click', () => {
    document.cookie = (eta.dataset.cookie ?? 'area51_adulti') + '=1; path=/; max-age=15552000; samesite=lax';
    location.reload();
  });
</script>

<script>
  /* Disponibilità con lo stato del negozio adesso (dipende dall'ora di chi guarda) */
  import { statoNegozio } from '../../lib/orari';
  const el = document.getElementById('stato-negozio');
  if (el) { const s = statoNegozio(); el.textContent = 'Negozio: ' + s.testo.charAt(0).toLowerCase() + s.testo.slice(1); el.hidden = false; }
</script>

<style>
  .pagina { padding-block: 2rem 4rem; }
  .prodotto { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; align-items: start; }
  @media (min-width: 768px) { .prodotto { grid-template-columns: 300px minmax(0, 1fr); gap: 3rem; } }
  .copertina { width: 100%; max-width: 300px; margin-inline: auto; aspect-ratio: 318 / 484; border-radius: var(--raggio); overflow: hidden; border: 2px solid rgb(185 230 46 / .6);
    box-shadow: var(--ombra-brutal); background: var(--scheda); }
  .copertina img { width: 100%; height: 100%; object-fit: cover; }
  .senza { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: 1.5rem; text-align: center; color: var(--testo-tenue); font-weight: 700; }
  .senza svg { width: 5rem; height: 5rem; }
  .dati { min-width: 0; display: grid; gap: 1.1rem; align-content: start; }
  .etichette { display: flex; flex-wrap: wrap; gap: .5rem; }
  .etichetta { font-size: .75rem; padding: .3rem .75rem; border-radius: .375rem; background: var(--lime); color: #000; }
  .etichetta.viola { background: var(--viola); color: #fff; }
  .etichetta.grigia { background: #3A2F5E; color: #fff; }
  .etichetta.arancio { background: #FB923C; color: #000; }
  .sfocata { filter: blur(22px) saturate(.5); transform: scale(1.15); }
  .eta { margin-bottom: 1.5rem; display: grid; gap: .6rem; padding: 1.25rem; border-radius: var(--raggio); border: 2px solid #FB923C; background: rgb(251 146 60 / .1); color: var(--testo-tenue); font-weight: 600; }
  .eta .pesante { color: #fff; font-size: 1.1rem; }
  .eta div { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .indietro { color: #fff; text-decoration: underline; font-weight: 700; }
  .etichetta.tenue { background: none; border: 1px solid var(--linea); color: var(--testo-tenue); font-weight: 700; }
  h1 { font-size: 2rem; line-height: 1.1; color: #fff; overflow-wrap: anywhere; text-wrap: balance; }
  @media (min-width: 640px) { h1 { font-size: 2.75rem; } }
  .volume { font-size: 1.5rem; color: var(--lime); margin-top: -.6rem; }
  .titolo-intero { color: var(--testo-tenue); font-weight: 700; margin-top: -.5rem; }
  .tabella { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1px; border-radius: var(--raggio); overflow: hidden; border: 1px solid var(--linea-tenue); background: var(--linea-tenue); margin: 0; }
  .tabella div { background: rgb(14 9 38 / .95); padding: .75rem 1rem; min-width: 0; }
  .tabella dt { font-size: 11px; font-weight: 700; color: var(--testo-tenue); text-transform: uppercase; letter-spacing: .05em; }
  .tabella dd { margin: .2rem 0 0; color: #fff; font-weight: 700; overflow-wrap: anywhere; }
  .acquisto { display: grid; gap: .9rem; padding: 1.25rem; border-radius: var(--raggio); border: 2px solid rgb(185 230 46 / .6); background: rgb(13 7 36 / .95); }
  .prezzo-riga { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; }
  .prezzo { font-size: 2rem; color: var(--lime); }
  .disponibile { display: inline-flex; align-items: center; gap: .5rem; font-weight: 700; font-size: .875rem; color: #fff; }
  .spia { width: .6rem; height: .6rem; border-radius: 50%; background: #FB923C; }
  .spia.verde { background: var(--lime); }
  .spia.viola { background: var(--viola-chiaro); }
  .negozio, .nota { font-size: .875rem; font-weight: 600; color: var(--testo-tenue); line-height: 1.5; }
  .etichetta-campo { font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; color: #fff; margin-bottom: .5rem; }
  .scelte { display: flex; flex-wrap: wrap; gap: .5rem; }
  .scelta { display: grid; gap: .1rem; padding: .55rem .9rem; border-radius: .75rem; border: 1px solid var(--linea); font-size: .8rem; min-width: 7rem; }
  .scelta b { color: #fff; }
  .scelta span { color: var(--testo-tenue); font-weight: 700; }
  a.scelta:hover { border-color: var(--lime); }
  .scelta.attiva { border: 2px solid var(--lime); }
  .bottoni { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .quantita select { appearance: none; background: var(--scheda); border: 1px solid var(--linea); border-radius: var(--raggio-pillola); padding: .7rem 2.2rem .7rem 1.1rem; color: #fff; font-weight: 700;
    background-image: linear-gradient(45deg, transparent 50%, var(--lime) 50%), linear-gradient(135deg, var(--lime) 50%, transparent 50%);
    background-position: calc(100% - 1.1rem) 50%, calc(100% - .8rem) 50%; background-size: .3rem .3rem; background-repeat: no-repeat; }
  .pulsante-viola { background: var(--viola); color: #fff; box-shadow: var(--ombra-brutal-lime); }
  .pulsante-viola:hover { background: var(--viola-acceso); }

  .sotto { margin-top: 3rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  @media (min-width: 1024px) { .sotto { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); } .ritiro { position: sticky; top: calc(var(--altezza-testata) + 1rem); } }
  .sotto h2 { font-size: 1.25rem; color: #fff; margin-bottom: .75rem; }
  .trama { display: grid; gap: .6rem; color: var(--testo-tenue); font-weight: 600; line-height: 1.6; }
  .trama .evid { color: #fff; }
  .ritiro ul { display: grid; gap: .75rem; margin-bottom: 1rem; }
  .ritiro li { display: grid; gap: .15rem; font-size: .85rem; color: var(--testo-tenue); font-weight: 600; }
  .ritiro b { color: #fff; font-size: .95rem; }
  .collegamento { color: var(--lime); font-weight: 700; font-size: .875rem; }
  .collegamento:hover { text-decoration: underline; }
  .elenco { margin-top: 3.5rem; }
  .piccolo { font-size: 1.5rem; margin-bottom: 1.25rem; }
  @media (min-width: 640px) { .piccolo { font-size: 2rem; } }
  .griglia { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  @media (min-width: 640px) { .griglia { gap: 1.25rem; } }
  @media (min-width: 1024px) { .griglia { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
