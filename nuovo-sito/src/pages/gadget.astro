---
import Base from '../layouts/Base.astro';
import PaginaCatalogo from '../components/catalogo/PaginaCatalogo.astro';
import { impostaCachePaginaDinamica } from '../lib/cache';

export const prerender = false;
impostaCachePaginaDinamica(Astro.response.headers);
---

<Base
  titolo="Gadget · Area 51 Fumetteria Barletta"
  descrizione="Gadget e idee regalo alla Fumetteria Area 51 di Barletta."
>
  <PaginaCatalogo
    categorie={['gadget']}
    percorso="Gadget"
    bollino="Idee regalo"
    titolo="Gadget"
    introduzione="Portachiavi, tazze, peluche e idee regalo."
    messaggioVuoto="I gadget arriveranno sul sito quando li registreremo in magazzino. Intanto passa in negozio."
  />
</Base>
