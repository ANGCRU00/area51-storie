---
import Base from '../layouts/Base.astro';
import PaginaCatalogo from '../components/catalogo/PaginaCatalogo.astro';
import { impostaCachePaginaDinamica } from '../lib/cache';

export const prerender = false;
impostaCachePaginaDinamica(Astro.response.headers);
---

<Base
  titolo="Manga & Fumetti · Area 51 Fumetteria Barletta"
  descrizione="Manga e fumetti alla Fumetteria Area 51 di Barletta: disponibili in negozio e prossime uscite da prenotare."
>
  <PaginaCatalogo
    categorie={['manga', 'fumetti']}
    percorso="Manga & Fumetti"
    bollino="Manga e fumetti"
    titolo="Manga & Fumetti"
    introduzione="Manga e fumetti in negozio e in arrivo: scegli online, ritiri e paghi in negozio. Le prossime uscite si prenotano."
  />
</Base>
