---
/* Giochi da tavolo: articoli del magazzino e prossime uscite da D1 (src/lib/prodotti.ts). Pagina scritta a ogni richiesta. */
import Base from '../layouts/Base.astro';
import Elenco from '../components/prodotti/Elenco.astro';
import { cercaProdotti, filtriDaIndirizzo, type Categoria } from '../lib/prodotti';

export const prerender = false;
const disponibili: Categoria[] = ['giochi'];
const filtri = filtriDaIndirizzo(Astro.url, disponibili);
const risultato = await cercaProdotti(filtri);
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60');
---
<Base titolo="Giochi da tavolo · Area 51 Fumetteria Barletta" descrizione="Giochi da tavolo e di ruolo alla Fumetteria Area 51 di Barletta.">
  <Elenco percorso="Giochi da tavolo" bollino="Giochi da tavolo e di ruolo" titolo="Giochi da tavolo" introduzione="Giochi da tavolo e di ruolo in negozio e in arrivo."
    risultato={risultato} filtri={filtri} categorie={disponibili} />
</Base>
