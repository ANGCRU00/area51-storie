---
import Base from '../layouts/Base.astro';
import PaginaCatalogo from '../components/catalogo/PaginaCatalogo.astro';
import { impostaCachePaginaDinamica } from '../lib/cache';

export const prerender = false;
impostaCachePaginaDinamica(Astro.response.headers);
---

<Base
  titolo="Giochi da tavolo · Area 51 Fumetteria Barletta"
  descrizione="Giochi da tavolo e di ruolo alla Fumetteria Area 51 di Barletta."
>
  <PaginaCatalogo
    categorie={['giochi']}
    percorso="Giochi da tavolo"
    bollino="Giochi da tavolo e di ruolo"
    titolo="Giochi da tavolo"
    introduzione="Giochi da tavolo e di ruolo in negozio e in arrivo."
  />
</Base>
