---
/* Figure & Funko: articoli del magazzino e prossime uscite da D1 (src/lib/prodotti.ts). Pagina scritta a ogni richiesta. */
import Base from '../layouts/Base.astro';
import Elenco from '../components/prodotti/Elenco.astro';
import { cercaProdotti, filtriDaIndirizzo, type Categoria } from '../lib/prodotti';

export const prerender = false;
const disponibili: Categoria[] = ['figure'];
const filtri = filtriDaIndirizzo(Astro.url, disponibili);
const risultato = await cercaProdotti(filtri);
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60');
---
<Base titolo="Figure & Funko · Area 51 Fumetteria Barletta" descrizione="Figure e Funko alla Fumetteria Area 51 di Barletta.">
  <Elenco percorso="Figure & Funko" bollino="Da collezione" titolo="Figure & Funko" introduzione="Figure, statue e Funko Pop."
    risultato={risultato} filtri={filtri} categorie={disponibili} vuoto="Figure e Funko arriveranno sul sito quando li registreremo in magazzino. Intanto passa in negozio." />
</Base>
