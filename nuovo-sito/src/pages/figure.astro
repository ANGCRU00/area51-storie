---
import Base from '../layouts/Base.astro';
import PaginaCatalogo from '../components/catalogo/PaginaCatalogo.astro';
import { impostaCachePaginaDinamica } from '../lib/cache';

export const prerender = false;
impostaCachePaginaDinamica(Astro.response.headers);
---

<Base
  titolo="Figure & Funko · Area 51 Fumetteria Barletta"
  descrizione="Figure e Funko alla Fumetteria Area 51 di Barletta."
>
  <PaginaCatalogo
    categorie={['figure']}
    percorso="Figure & Funko"
    bollino="Da collezione"
    titolo="Figure & Funko"
    introduzione="Figure, statue e Funko Pop."
    messaggioVuoto="Figure e Funko arriveranno sul sito quando li registreremo in magazzino. Intanto passa in negozio."
  />
</Base>
