---
/* Warhammer: articoli del magazzino e prossime uscite da D1 (src/lib/prodotti.ts). Pagina scritta a ogni richiesta. */
import Base from '../layouts/Base.astro';
import Elenco from '../components/prodotti/Elenco.astro';
import { cercaProdotti, filtriDaIndirizzo, type Categoria } from '../lib/prodotti';

export const prerender = false;
const disponibili: Categoria[] = [];
const filtri = filtriDaIndirizzo(Astro.url, disponibili);
const risultato = await cercaProdotti(filtri);
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=60');
---
<Base titolo="Warhammer · Area 51 Fumetteria Barletta" descrizione="Warhammer alla Fumetteria Area 51 di Barletta.">
  <Elenco percorso="Warhammer" bollino="Miniature" titolo="Warhammer" introduzione="Miniature, colori e accessori Warhammer."
    risultato={risultato} filtri={filtri} categorie={disponibili} vuoto="Il reparto Warhammer non è ancora sul sito: chiedi in negozio per miniature, colori e serate di pittura." />
</Base>
