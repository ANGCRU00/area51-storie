---
import Base from '../layouts/Base.astro';
import PaginaCatalogo from '../components/catalogo/PaginaCatalogo.astro';
import { impostaCachePaginaDinamica } from '../lib/cache';

export const prerender = false;
impostaCachePaginaDinamica(Astro.response.headers);
---

<Base
  titolo="Warhammer · Area 51 Fumetteria Barletta"
  descrizione="Warhammer alla Fumetteria Area 51 di Barletta."
>
  <PaginaCatalogo
    categorie={[]}
    percorso="Warhammer"
    bollino="Miniature"
    titolo="Warhammer"
    introduzione="Miniature, colori e accessori Warhammer."
    messaggioVuoto="Il reparto Warhammer non è ancora sul sito: chiedi in negozio per miniature, colori e serate di pittura."
  />
</Base>
