---
import Base from '../layouts/Base.astro';
import PaginaAccesso from '../components/comuni/PaginaAccesso.astro';
import ModuloAccesso from '../components/isole/ModuloAccesso.tsx';
---

<Base titolo="Password dimenticata · Area 51 Fumetteria">
  <PaginaAccesso
    titolo="Password dimenticata?"
    introduzione="Scrivi l'email del tuo account: ti mandiamo un link per sceglierne una nuova."
  >
    <ModuloAccesso client:load modo="recupera" />
    <Fragment slot="altri">
      <span>
        <a href="/accedi">Torna ad accedere</a>
      </span>
    </Fragment>
  </PaginaAccesso>
</Base>
