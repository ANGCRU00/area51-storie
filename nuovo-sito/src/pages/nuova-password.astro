---
import Base from '../layouts/Base.astro';
import PaginaAccesso from '../components/comuni/PaginaAccesso.astro';
import ModuloAccesso from '../components/isole/ModuloAccesso.tsx';

export const prerender = false;
const token = (Astro.url.searchParams.get('token') ?? '').slice(0, 300);
const linkScaduto = Astro.url.searchParams.get('error') === 'INVALID_TOKEN' || !token;
---

<Base titolo="Nuova password · Area 51 Fumetteria">
  <PaginaAccesso
    titolo="Scegli una nuova password"
    introduzione="Dopo il cambio ti chiederemo di accedere di nuovo, su tutti i dispositivi."
  >
    {linkScaduto ? (
      <p class="scaduto">
        Il link non è valido o è scaduto. <a href="/recupera-password">Chiedine uno nuovo</a>.
      </p>
    ) : (
      <ModuloAccesso client:load modo="nuova" token={token} />
    )}
  </PaginaAccesso>
</Base>

<style>
  .scaduto {
    font-weight: 700;
    color: #fb923c;
  }
  .scaduto a {
    color: #fff;
    text-decoration: underline;
  }
</style>
