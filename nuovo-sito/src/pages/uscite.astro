---
import Base from '../layouts/Base.astro';
import PaginaCatalogo from '../components/catalogo/PaginaCatalogo.astro';
import { impostaCachePaginaDinamica } from '../lib/cache';

export const prerender = false;
impostaCachePaginaDinamica(Astro.response.headers);
---

<Base
  titolo="Prossime uscite · Area 51 Fumetteria Barletta"
  descrizione="Manga, fumetti, carte e giochi in uscita nei prossimi mesi: prenotali alla Fumetteria Area 51 di Barletta."
>
  <PaginaCatalogo
    categorie={['manga', 'fumetti', 'tcg', 'giochi']}
    percorso="Prossime uscite"
    bollino="Prenota le novità"
    titolo="Prossime uscite"
    introduzione="Manga, fumetti, carte e giochi in arrivo nelle prossime settimane. Prenota quello che ti interessa: lo ordiniamo per te e lo ritiri in negozio."
    filtriFissi={{ stato: 'preordini', ordine: 'uscita', perPagina: 40 }}
    conStato={false}
    conMese
  />
</Base>
