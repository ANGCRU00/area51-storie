---
/* Home: apertura, nastro, novità, club, eventi. Novità e uscite da D1; eventi ancora provvisori (fase 8). */
import Base from '../layouts/Base.astro';
import Apertura from '../components/home/Apertura.astro';
import Nastro from '../components/home/Nastro.astro';
import Novita from '../components/home/Novita.astro';
import Club from '../components/home/Club.astro';
import Eventi from '../components/home/Eventi.astro';
import { perLaHome } from '../lib/prodotti';
import { impostaCachePaginaDinamica } from '../lib/cache';

export const prerender = false;
const { appena, prossime } = await perLaHome();
impostaCachePaginaDinamica(Astro.response.headers);
---

<Base
  titolo="Area 51 Fumetteria | Manga, giochi, carte e collezionismo a Barletta"
  descrizione="Fumetteria Area 51 a Barletta: manga, fumetti, carte TCG, figure, Warhammer e tornei. Viale G. Falcone e P. Borsellino 35."
>
  <Apertura ultimo={appena[0]} />
  <Nastro />
  <Novita appena={appena} prossime={prossime} />
  <Club />
  <Eventi />
</Base>
