<script is:inline>
(function () {
  function euroIt(n) { return Number(n).toLocaleString('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }); }
  function disegnaLivelli(box, l) {
    box.textContent = '';
    if (!l.length) {
      /* Nessun livello nel database: restano i nomi scelti dal negozio, con soglie e vantaggi da definire */
      ['Avvistamento', 'Rapito dagli alieni', 'Amico degli Alieni'].forEach(function (nome, i) {
        var li = document.createElement('li'); li.className = 'flex items-start gap-3 rounded-xl border border-white/10 bg-[#120a2e] px-3 py-2 sm:px-4 sm:py-3';
        var n = document.createElement('span'); n.className = 'shrink-0 w-7 h-7 rounded-full bg-brand-lime text-black font-heavy text-xs hidden sm:flex items-center justify-center'; n.textContent = String(i + 1);
        var d = document.createElement('span'); d.className = 'min-w-0';
        var t1 = document.createElement('b'); t1.className = 'block font-heavy text-white'; t1.textContent = nome;
        var t2 = document.createElement('span'); t2.className = 'block text-sm font-semibold text-brand-muted'; t2.textContent = '[SOGLIA] · [VANTAGGIO]';
        d.appendChild(t1); d.appendChild(t2); li.appendChild(n); li.appendChild(d); box.appendChild(li);
      });
      return;
    }
    l.forEach(function (x, i) {
      var li = document.createElement('li'); li.className = 'flex items-start gap-3 rounded-xl border border-white/10 bg-[#120a2e] px-3 py-2 sm:px-4 sm:py-3';
      var n = document.createElement('span'); n.className = 'shrink-0 w-7 h-7 rounded-full bg-brand-lime text-black font-heavy text-xs hidden sm:flex items-center justify-center'; n.textContent = String(i + 1);
      var d = document.createElement('span'); d.className = 'min-w-0';
      var t1 = document.createElement('b'); t1.className = 'block font-heavy text-white'; t1.textContent = x.nome;
      var t2 = document.createElement('span'); t2.className = 'block text-xs font-bold text-brand-lime uppercase tracking-wider'; t2.textContent = Number(x.soglia) > 0 ? 'da ' + euroIt(x.soglia) + ' spesi' : 'dall\'iscrizione';
      var t3 = document.createElement('span'); t3.className = 'block text-sm font-semibold text-brand-muted mt-0.5'; t3.textContent = x.vantaggio;
      d.appendChild(t1); d.appendChild(t2); d.appendChild(t3); li.appendChild(n); li.appendChild(d); box.appendChild(li);
    });
  }
  var box = document.getElementById('club-livelli'); if (box) A51DB.livelli().then(function (l) { disegnaLivelli(box, l); });
})();
</script>
